          }
        },
        "additionalProperties": false
      },
      "CreateMovieDTO": {
        "required": [
          "availableSeats",
          "director",
          "duration",
          "rating",
          "releaseYear",
          "ticketPrice",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "director": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "duration": {
            "maximum": 300,
            "minimum": 30,
            "type": "integer",
            "format": "int32"
          },
          "releaseYear": {
            "maximum": 2026,
            "minimum": 1950,
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "ticketPrice": {
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "availableSeats": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "genreId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CustomerDTO": {
        "required": [
          "email",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "format": "tel",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
